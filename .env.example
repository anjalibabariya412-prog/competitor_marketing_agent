# =============================================================================
# Competitor Marketing Agent - Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# Do not commit real secrets or .env to version control.

# -----------------------------------------------------------------------------
# LLM & OpenAI Configuration
# -----------------------------------------------------------------------------
# Required: Secret OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Required: Canonical LLM Model identifier (e.g. gpt-4o, gpt-4o-mini, gpt-6-luna)
LLM_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Web Scraping Configuration
# -----------------------------------------------------------------------------
# Required: Secret Apify API Token
APIFY_API_TOKEN=your_apify_api_token_here

# Scraper Provider (default: apify)
SCRAPER_PROVIDER=apify

# Maximum pages to scrape from user's business website (default: 8)
MAX_PAGES_USER_SITE=8

# Maximum pages to scrape per competitor site (default: 8)
MAX_PAGES_PER_COMPETITOR=8

# Maximum total number of competitors to analyze (default: 5)
MAX_COMPETITORS=5

# Maximum number of competitors to discover automatically (default: 3)
MAX_AUTO_COMPETITORS=3

# Additional milliseconds to wait for dynamic JS hydration on homepage (default: 1500, range: 0-10000)
HOMEPAGE_RENDER_WAIT_MS=1500

# Maximum pixel scroll height for triggering lazy-loaded homepage content (default: 2500, range: 0-10000)
HOMEPAGE_MAX_SCROLL_HEIGHT_PIXELS=2500

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Required: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitor_agent

# -----------------------------------------------------------------------------
# Application Environment & Logging
# -----------------------------------------------------------------------------
# Allowed values: development, production (default: development)
APP_ENV=development

# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional Competitor Discovery / Search Service
# -----------------------------------------------------------------------------
# Optional: API key for search/discovery services (default: None)
SEARCH_API_KEY=
